#include <BluetoothSerial.h>
#include <freertos/FreeRTOS.h>
#include <freertos/task.h>
#include <freertos/timers.h>

// Check if Bluetooth is enabled
#if !defined(CONFIG_BT_ENABLED) || !defined(CONFIG_BLUEDROID_ENABLED)
#error Bluetooth is not enabled! Please run `make menuconfig` to enable it
#endif

// Check if Serial Bluetooth is enabled
#if !defined(CONFIG_BT_SPP_ENABLED)
#error Serial Bluetooth not available or not enabled. It is only available for the ESP32 chip.
#endif

BluetoothSerial SerialBT;

// Constants
const int GPS_BAUD_RATE      = 115200;    // Adjust based on your module's actual baud rate
const int SERIAL_BAUD_RATE   = 115200;
const char* BT_DEVICE_NAME   = "Global-GNSS";
const int LED_ERROR_PIN      = 2;       // Using GPIO2
const int GPS_BUFFER_SIZE    = 1024;
const int ERROR_LED_BLINK_COUNT = 10;   // LED blink count on error
const int ERROR_BLINK_INTERVAL   = 100; // Blink interval in ms

// Global variables
char gpsBuffer[GPS_BUFFER_SIZE];
int  bufferIndex  = 0;
bool errorState   = false;
int  blinkCounter = 0;
unsigned long lastBlinkTime = 0;

// Task handles
TaskHandle_t gpsTaskHandle      = NULL;
TaskHandle_t bluetoothTaskHandle= NULL;
TaskHandle_t errorLedTaskHandle = NULL;

void setup() {
  // Initialize USB Serial and GPS Serial
  Serial.begin(SERIAL_BAUD_RATE);
  Serial2.begin(GPS_BAUD_RATE, SERIAL_8N1, 16, 17);  // RX: GPIO16, TX: GPIO17

  // Initialize Bluetooth
  SerialBT.begin(BT_DEVICE_NAME);
  Serial.println("Bluetooth device started, you can pair it with Bluetooth!");
  SerialBT.println("Bluetooth connected!");

  // Initialize error indicator LED
  pinMode(LED_ERROR_PIN, OUTPUT);
  digitalWrite(LED_ERROR_PIN, LOW);

  // Create FreeRTOS tasks
  xTaskCreate(gpsTask,       "GPS Task",       2048, NULL, 1, &gpsTaskHandle);
  xTaskCreate(bluetoothTask, "Bluetooth Task", 2048, NULL, 1, &bluetoothTaskHandle);
  xTaskCreate(errorLedTask,  "Error LED Task", 2048, NULL, 1, &errorLedTaskHandle);
}

void loop() {
  // Main loop does nothing; all work is handled in tasks
}

void gpsTask(void *pvParameters) {
  while (true) {
    readGPS();
    vTaskDelay(pdMS_TO_TICKS(10)); // 10 ms delay to yield CPU
  }
}

void bluetoothTask(void *pvParameters) {
  while (true) {
    // If Bluetooth data is received, handle it here
    if (SerialBT.available()) {
      Serial.write(SerialBT.read());
    }
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

void errorLedTask(void *pvParameters) {
  while (true) {
    handleErrorLED();
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

// Buffer line by line and forward to USB Serial and Bluetooth
void readGPS() {
  while (Serial2.available()) {
    char c = Serial2.read();

    // Store in buffer
    if (bufferIndex < GPS_BUFFER_SIZE - 1) {
      gpsBuffer[bufferIndex++] = c;
    }

    // Detect end of line or buffer full
    if (c == '\n' || bufferIndex >= GPS_BUFFER_SIZE - 1) {
      gpsBuffer[bufferIndex] = '\0';

      // If it's a standard NMEA sentence (starts with '$')
      if (gpsBuffer[0] == '$') {
        // Send to USB Serial
        Serial.print(gpsBuffer);
        // Send to Bluetooth
        SerialBT.print(gpsBuffer);
      } else {
        logError("Invalid NMEA sentence received");
      }

      // Reset index for next line
      bufferIndex = 0;
    }
  }
}

void handleErrorLED() {
  if (errorState && blinkCounter < ERROR_LED_BLINK_COUNT * 2) {
    unsigned long now = millis();
    if (now - lastBlinkTime >= ERROR_BLINK_INTERVAL) {
      lastBlinkTime = now;
      digitalWrite(LED_ERROR_PIN, !digitalRead(LED_ERROR_PIN));
      blinkCounter++;
    }
  } else {
    // Reset after blinking is complete
    digitalWrite(LED_ERROR_PIN, LOW);
    errorState = false;
  }
}

void logError(const char* message) {
  Serial.print("ERROR: ");
  Serial.println(message);
  SerialBT.print("ERROR: ");
  SerialBT.println(message);

  // Trigger LED blinking
  errorState   = true;
  blinkCounter = 0;
  lastBlinkTime= millis();
}
